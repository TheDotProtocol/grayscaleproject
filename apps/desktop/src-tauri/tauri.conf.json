{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Grayscale",
  "version": "0.1.0",
  "identifier": "com.projectgrayscale.app",
  "build": {
    "frontendDist": "../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @grayscale/web dev",
    "beforeBuildCommand": "pnpm --filter @grayscale/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Project Grayscale",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  }
}
