generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Seed test user for development
// Run: pnpm db:seed

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Identity ───────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  founderProfile FounderProfile?
  companies      CompanyMember[]
  journalEntries JournalEntry[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model FounderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  bio         String?
  timezone    String   @default("UTC")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("founder_profiles")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  stage     String   @default("idea")
  industry  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        CompanyMember[]
  memories       Memory[]
  journalEntries JournalEntry[]
  timelineEvents TimelineEvent[]
  bills          Bill[]
  knowledgeNodes KnowledgeNode[] // deprecated — migrate to graph_nodes
  knowledgeEdges KnowledgeEdge[] // deprecated — migrate to graph_edges
  graphNodes     GraphNode[]
  graphEdges     GraphEdge[]
  agentRuns      AgentRun[]
  aiProviders    AiProviderConfig[]
  notifications  Notification[]
  briefings      DailyBriefing[]
  integrations   Integration[]
  pulseEvents    PulseEvent[]
  domainEvents   DomainEvent[]
  memoryRecords  MemoryRecord[]
  goals          Goal[]
  objectives     Objective[]
  recommendations Recommendation[]
  decisions      Decision[]
  riskAssessments RiskAssessment[]
  opportunities  Opportunity[]
  priorityScores PriorityScore[]
  priorityConfigs PriorityConfig[]
  decisionPolicies DecisionPolicy[]
  strategicConstraints StrategicConstraint[]
  scenarioPlans  ScenarioPlan[]
  companyOperatingModes CompanyOperatingMode[]
  executiveInstances    ExecutiveInstance[]
  installedPlugins      InstalledPlugin[]
  integrationCredentials IntegrationCredential[]
  normalizedEntities    NormalizedEntityRecord[]
  missionControlLayouts MissionControlLayout[]
  platformHealthSnapshots PlatformHealthSnapshot[]
  readinessSnapshots    ReadinessSnapshot[]
  platformJobs          PlatformJob[]

  @@map("companies")
}

model CompanyMember {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  role      String   @default("founder")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

// ─── Founder Memory (Phase 1) ───────────────────────────────

model Memory {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  title     String
  content   String
  summary   String?
  tags      String[]
  source    String   @default("manual")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("memories")
}

model JournalEntry {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  content   String
  summary   String?
  mood      String?
  tags      String[]
  entryDate DateTime @default(now()) @map("entry_date")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, entryDate])
  @@map("journal_entries")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  title       String
  description String?
  eventType   String   @map("event_type")
  occurredAt  DateTime @map("occurred_at")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, occurredAt])
  @@map("timeline_events")
}

// ─── Knowledge Graph (Sprint 1 — DEPRECATED, use graph_nodes) ─

model KnowledgeNode {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  label     String
  nodeType  String   @map("node_type")
  content   String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  edgesFrom  KnowledgeEdge[] @relation("EdgeFrom")
  edgesTo    KnowledgeEdge[] @relation("EdgeTo")

  @@index([companyId])
  @@map("knowledge_nodes")
}

model KnowledgeEdge {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  fromNodeId   String   @map("from_node_id")
  toNodeId     String   @map("to_node_id")
  relationship String
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now()) @map("created_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromNode KnowledgeNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   KnowledgeNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("knowledge_edges")
}

// ─── Billing Reminders ──────────────────────────────────────

model Bill {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  amountCents Int       @map("amount_cents")
  currency    String    @default("USD")
  dueDate     DateTime  @map("due_date")
  recurrence  String    @default("monthly")
  category    String?
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, dueDate])
  @@map("bills")
}

// ─── Agents (Phase 2 foundation) ──────────────────────────

model AgentRun {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  executiveId  String   @map("executive_id")
  prompt       String
  result       Json?
  status       String   @default("pending")
  tokensUsed   Int?     @map("tokens_used")
  createdAt    DateTime @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recommendations AgentRecommendation[]

  @@index([companyId, executiveId])
  @@map("agent_runs")
}

model AgentRecommendation {
  id               String   @id @default(uuid())
  agentRunId       String   @map("agent_run_id")
  title            String
  summary          String
  reasoning        String
  confidence       Float
  roiEstimate      String?  @map("roi_estimate")
  requiresApproval Boolean  @default(true) @map("requires_approval")
  approvalStatus   String?  @map("approval_status")
  createdAt        DateTime @default(now()) @map("created_at")

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@map("agent_recommendations")
}

// ─── AI Provider Config ─────────────────────────────────────

model AiProviderConfig {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  provider  String
  model     String
  isDefault Boolean  @default(false) @map("is_default")
  isEnabled Boolean  @default(true) @map("is_enabled")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@map("ai_provider_configs")
}

// ─── Notifications & Briefings ──────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model DailyBriefing {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  content   Json
  summary   String
  briefingDate DateTime @map("briefing_date")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, briefingDate])
  @@map("daily_briefings")
}

// ─── Integrations ───────────────────────────────────────────

model Integration {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  provider    String
  accessToken String?   @map("access_token")
  config      Json      @default("{}")
  status      String    @default("connected")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@map("integrations")
}

// ─── Pulse Engine (operational heartbeats) ─────────────────

model PulseEvent {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  type          String
  domainType    String?  @map("domain_type")
  title         String
  summary       String?
  severity      String   @default("info")
  category      String
  payload       Json     @default("{}")
  correlationId String   @map("correlation_id")
  source        String
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, category])
  @@map("pulse_events")
}

// ─── Event Store (Phase 1.5A) ───────────────────────────────

model DomainEvent {
  id            String    @id
  sequence      BigInt    @default(autoincrement())
  companyId     String    @map("company_id")
  type          String
  version       Int       @default(1)
  userId        String?   @map("user_id")
  payload       Json
  correlationId String    @map("correlation_id")
  causationId   String?   @map("causation_id")
  traceId       String?   @map("trace_id")
  source        String
  status        String    @default("pending")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  failures DomainEventFailure[]

  @@index([companyId, sequence])
  @@index([companyId, type])
  @@index([correlationId])
  @@index([status])
  @@map("domain_events")
}

model DomainEventFailure {
  id            String    @id @default(uuid())
  domainEventId String    @map("domain_event_id")
  projector     String?
  error         String
  stack         String?
  attempt       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  domainEvent DomainEvent @relation(fields: [domainEventId], references: [id], onDelete: Cascade)

  @@index([domainEventId])
  @@map("domain_event_failures")
}

// ─── Memory Index (Phase 1.5B) ──────────────────────────────

model MemoryRecord {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  userId      String?  @map("user_id")
  department  String?
  memoryType  String   @map("memory_type")
  sourceTable String   @map("source_table")
  sourceId    String   @map("source_id")
  title       String
  summary     String?
  tags        String[]
  metadata    Json     @default("{}")
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // v2 identity & relationship readiness
  version     Int      @default(1)
  status      String   @default("active")
  visibility  String   @default("company")
  provenance  String   @default("unknown")
  confidence  String   @default("unknown")
  parentId    String?  @map("parent_id")
  relatedIds  String[] @default([]) @map("related_ids")
  ownerId     String?  @map("owner_id")
  projectId   String?  @map("project_id")
  graphNodeId String?  @map("graph_node_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([sourceTable, sourceId])
  @@index([companyId, memoryType])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([graphNodeId])
  @@map("memory_records")
}

// ─── Company Knowledge Graph (Phase 1.5C) ───────────────────

model GraphNode {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  nodeType        String   @map("node_type")
  displayName     String   @map("display_name")
  summary         String?
  lifecycleStatus String   @default("active") @map("lifecycle_status")
  sourceTable     String?  @map("source_table")
  sourceId        String?  @map("source_id")
  source          String   @default("system")
  schemaVersion   Int      @default(1) @map("schema_version")
  version         Int      @default(1)
  metadata        Json     @default("{}")
  memoryRecordId  String?  @map("memory_record_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  edgesFrom GraphEdge[] @relation("GraphEdgeFrom")
  edgesTo   GraphEdge[] @relation("GraphEdgeTo")

  @@unique([companyId, sourceTable, sourceId])
  @@index([companyId, nodeType])
  @@index([companyId, lifecycleStatus])
  @@map("graph_nodes")
}

model GraphEdge {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  sourceNodeId     String   @map("source_node_id")
  targetNodeId     String   @map("target_node_id")
  relationshipType String   @map("relationship_type")
  strength         Float    @default(1.0)
  confidence       String   @default("unknown")
  direction        String   @default("directed")
  lifecycleStatus  String   @default("active") @map("lifecycle_status")
  schemaVersion    Int      @default(1) @map("schema_version")
  version          Int      @default(1)
  metadata         Json     @default("{}")
  evidence         Json     @default("[]")
  reason           String?
  createdBy        String?  @map("created_by")
  edgeSource       String   @default("system") @map("edge_source")
  sourceEventId    String?  @map("source_event_id")
  correlationId    String?  @map("correlation_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceNode GraphNode @relation("GraphEdgeFrom", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode GraphNode @relation("GraphEdgeTo", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([companyId, sourceNodeId, targetNodeId, relationshipType])
  @@index([companyId, sourceNodeId])
  @@index([companyId, targetNodeId])
  @@index([companyId, relationshipType])
  @@map("graph_edges")
}

// ─── Strategic Intelligence Framework (Phase 1.5D) ──────────

model Goal {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  scope            String
  department       String?
  title            String
  description      String?
  successCriteria  Json      @default("[]") @map("success_criteria")
  priorityWeight   Float     @default(0.5) @map("priority_weight")
  status           String    @default("active")
  health           String    @default("unknown")
  progress         Float     @default(0)
  ownerId          String?   @map("owner_id")
  deadline         DateTime?
  graphNodeId      String?   @map("graph_node_id")
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  objectives Objective[]

  @@index([companyId, status])
  @@map("goals")
}

model Objective {
  id                     String    @id @default(uuid())
  companyId              String    @map("company_id")
  goalId                 String    @map("goal_id")
  title                  String
  description            String?
  status                 String    @default("not_started")
  completion             Float     @default(0)
  deadline               DateTime?
  ownerId                String?   @map("owner_id")
  dependencyObjectiveIds String[]  @default([]) @map("dependency_objective_ids")
  linkedProjectIds       String[]  @default([]) @map("linked_project_ids")
  graphNodeId            String?   @map("graph_node_id")
  metadata               Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([companyId, goalId])
  @@map("objectives")
}

model Recommendation {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  title               String
  summary             String
  reasoning           String
  evidence            Json     @default("[]")
  alternatives        Json     @default("[]")
  confidenceSources   Json     @default("[]") @map("confidence_sources")
  tradeOff            Json     @default("{}") @map("trade_off")
  dependencies        String[] @default([])
  riskAssessmentIds   String[] @default([]) @map("risk_assessment_ids")
  estimatedCostCents  Int?     @map("estimated_cost_cents")
  engineeringCost     Float?   @map("engineering_cost")
  estimatedRoi        String?  @map("estimated_roi")
  confidence          Float    @default(0.5)
  confidenceBand      String   @default("unknown") @map("confidence_band")
  priorityScoreId     String?  @map("priority_score_id")
  department          String?
  source              String   @default("system")
  sourceRef           String?  @map("source_ref")
  requiresApproval    Boolean  @default(true) @map("requires_approval")
  status              String   @default("draft")
  expectedOutcome     String?  @map("expected_outcome")
  expectedTimeline    String?  @map("expected_timeline")
  rollbackStrategy    String?  @map("rollback_strategy")
  graphNodeId         String?  @map("graph_node_id")
  memoryRecordIds     String[] @default([]) @map("memory_record_ids")
  scenarioIds         String[] @default([]) @map("scenario_ids")
  policyViolations    String[] @default([]) @map("policy_violations")
  constraintViolations String[] @default([]) @map("constraint_violations")
  createdBy           String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audits  RecommendationAudit[]
  decisions Decision[]

  @@index([companyId, status])
  @@index([companyId, source])
  @@map("recommendations")
}

model RecommendationAudit {
  id               String   @id @default(uuid())
  recommendationId String   @map("recommendation_id")
  action           String
  actorId          String   @map("actor_id")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("recommendation_audits")
}

model Decision {
  id                     String    @id @default(uuid())
  companyId              String    @map("company_id")
  recommendationId       String?   @map("recommendation_id")
  title                  String
  status                 String    @default("proposed")
  alternativesConsidered Json      @default("[]") @map("alternatives_considered")
  decisionMakerId        String    @map("decision_maker_id")
  decisionDate           DateTime  @default(now()) @map("decision_date")
  reasoning              String
  evidence               Json      @default("[]")
  implementationState    String    @default("not_started") @map("implementation_state")
  outcome                Json?
  reviewDate             DateTime? @map("review_date")
  graphNodeId            String?   @map("graph_node_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  audits         DecisionAudit[]

  @@index([companyId, status])
  @@map("decisions")
}

model DecisionAudit {
  id         String   @id @default(uuid())
  decisionId String   @map("decision_id")
  action     String
  actorId    String   @map("actor_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("decision_audits")
}

model RiskAssessment {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  category         String
  title            String
  description      String
  severity         String   @default("medium")
  likelihood       Float    @default(0.5)
  impact           Float    @default(0.5)
  score            Float    @default(0.25)
  mitigation       String?
  linkedEntityType String?  @map("linked_entity_type")
  linkedEntityId   String?  @map("linked_entity_id")
  graphNodeId      String?  @map("graph_node_id")
  source           String   @default("system")
  createdAt        DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, category])
  @@map("risk_assessments")
}

model Opportunity {
  id                     String   @id @default(uuid())
  companyId              String   @map("company_id")
  category               String
  title                  String
  description            String
  estimatedValueCents    Int?     @map("estimated_value_cents")
  confidence             Float    @default(0.5)
  linkedRecommendationId String?  @map("linked_recommendation_id")
  status                 String   @default("identified")
  graphNodeId            String?  @map("graph_node_id")
  source                 String   @default("system")
  createdAt              DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("opportunities")
}

model PriorityScore {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  score      Float
  rank       Int?
  reasoning  Json
  configId   String?  @map("config_id")
  computedAt DateTime @default(now()) @map("computed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType])
  @@map("priority_scores")
}

model PriorityConfig {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  scope         String
  scopeRef      String?  @map("scope_ref")
  weights       Json
  operatingMode String?  @map("operating_mode")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, scope])
  @@map("priority_configs")
}

model DecisionPolicy {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  category  String
  rules     Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, category])
  @@map("decision_policies")
}

model StrategicConstraint {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  type         String
  limitValue   Float    @map("limit_value")
  unit         String
  currentUsage Float    @default(0) @map("current_usage")
  isHard       Boolean  @default(true) @map("is_hard")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
  @@map("strategic_constraints")
}

model ScenarioPlan {
  id                      String   @id @default(uuid())
  companyId               String   @map("company_id")
  name                    String
  caseType                String   @map("case_type")
  assumptions             Json     @default("{}")
  outcomes                Json     @default("{}")
  linkedRecommendationIds String[] @default([]) @map("linked_recommendation_ids")
  createdAt               DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("scenario_plans")
}

model CompanyOperatingMode {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  mode          String
  effectiveFrom DateTime @default(now()) @map("effective_from")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, effectiveFrom(sort: Desc)])
  @@map("company_operating_modes")
}

// ─── Executive Runtime Framework (Phase 1.5E) ───────────────

model ExecutiveInstance {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  executiveId    String    @map("executive_id")
  lifecycleState String    @default("created") @map("lifecycle_state")
  capabilities   Json      @default("[]")
  permissions    Json      @default("[]")
  metadata       Json      @default("{}")
  lastContextAt  DateTime? @map("last_context_at")
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages   ExecutiveMessage[]
  inboxItems ExecutiveInboxItem[]
  auditLogs  ExecutiveAuditLog[]
  outputs    ExecutiveOutput[]

  @@unique([companyId, executiveId])
  @@index([companyId, lifecycleState])
  @@map("executive_instances")
}

model ExecutiveMessage {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  instanceId      String?   @map("instance_id")
  messageType     String    @map("message_type")
  fromExecutiveId String?   @map("from_executive_id")
  toExecutiveId   String?   @map("to_executive_id")
  subject         String
  payload         Json      @default("{}")
  status          String    @default("pending")
  correlationId   String    @map("correlation_id")
  traceId         String?   @map("trace_id")
  causationId     String?   @map("causation_id")
  retryCount      Int       @default(0) @map("retry_count")
  maxRetries      Int       @default(3) @map("max_retries")
  timeoutAt       DateTime? @map("timeout_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  deliveredAt     DateTime? @map("delivered_at")

  instance ExecutiveInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([companyId, toExecutiveId, status])
  @@index([correlationId])
  @@map("executive_messages")
}

model ExecutiveInboxItem {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  instanceId    String   @map("instance_id")
  executiveId   String   @map("executive_id")
  queue         String
  itemType      String   @map("item_type")
  title         String
  payload       Json     @default("{}")
  priority      Int      @default(0)
  correlationId String?  @map("correlation_id")
  traceId       String?  @map("trace_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  instance ExecutiveInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, queue])
  @@index([companyId, executiveId])
  @@map("executive_inbox_items")
}

model ExecutiveAuditLog {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  instanceId    String?  @map("instance_id")
  executiveId   String?  @map("executive_id")
  action        String
  actorType     String   @map("actor_type")
  actorId       String?  @map("actor_id")
  metadata      Json     @default("{}")
  correlationId String?  @map("correlation_id")
  traceId       String?  @map("trace_id")
  createdAt     DateTime @default(now()) @map("created_at")

  instance ExecutiveInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([companyId, executiveId])
  @@index([correlationId])
  @@map("executive_audit_logs")
}

model ExecutiveOutput {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  instanceId     String   @map("instance_id")
  executiveId    String   @map("executive_id")
  outputType     String   @map("output_type")
  title          String
  summary        String
  explainability Json
  payload        Json     @default("{}")
  correlationId  String   @map("correlation_id")
  traceId        String?  @map("trace_id")
  createdAt      DateTime @default(now()) @map("created_at")

  instance ExecutiveInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([companyId, executiveId])
  @@index([instanceId])
  @@map("executive_outputs")
}

// ─── Integration & Plugin Platform (Phase 1.5F) ─────────────

model InstalledPlugin {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  pluginId      String   @map("plugin_id")
  version       String
  state         String   @default("registered")
  config        Json     @default("{}")
  permissions   Json     @default("[]")
  sandboxPolicy Json     @default("{}") @map("sandbox_policy")
  manifest      Json     @default("{}")
  installedAt   DateTime @default(now()) @map("installed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pluginId])
  @@index([companyId, state])
  @@map("installed_plugins")
}

model IntegrationCredential {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  provider        String
  encryptedSecret String    @map("encrypted_secret")
  keyVersion      Int       @default(1) @map("key_version")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  rotatedAt       DateTime? @map("rotated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audits  CredentialAuditLog[]

  @@unique([companyId, provider])
  @@map("integration_credentials")
}

model CredentialAuditLog {
  id           String   @id @default(uuid())
  credentialId String   @map("credential_id")
  companyId    String   @map("company_id")
  provider     String
  action       String
  actorId      String?  @map("actor_id")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  credential IntegrationCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([companyId, provider])
  @@map("credential_audit_logs")
}

model PluginSyncJob {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  pluginId    String    @map("plugin_id")
  provider    String
  status      String    @default("pending")
  idempotencyKey String? @map("idempotency_key")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  error       String?
  stats       Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId, pluginId])
  @@index([status])
  @@map("plugin_sync_jobs")
}

model NormalizedEntityRecord {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  entityType     String   @map("entity_type")
  sourceProvider String   @map("source_provider")
  sourceId       String   @map("source_id")
  payloadHash    String   @map("payload_hash")
  idempotencyKey String   @map("idempotency_key")
  displayName    String   @map("display_name")
  summary        String?
  occurredAt     DateTime @map("occurred_at")
  metadata       Json     @default("{}")
  memoryRecordId String?  @map("memory_record_id")
  graphNodeId    String?  @map("graph_node_id")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, sourceProvider])
  @@map("normalized_entity_records")
}

model IntegrationHealthSnapshot {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  provider        String
  pluginId        String?  @map("plugin_id")
  state           String
  message         String?
  authStatus      String   @map("auth_status")
  lastSyncAt      DateTime? @map("last_sync_at")
  webhookStatus   String   @default("inactive") @map("webhook_status")
  recordedAt      DateTime @default(now()) @map("recorded_at")

  @@index([companyId, provider])
  @@map("integration_health_snapshots")
}

model IntegrationCostSnapshot {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  provider           String
  period             String
  apiRequests        Int      @default(0) @map("api_requests")
  rateLimitHits      Int      @default(0) @map("rate_limit_hits")
  monthlyUsageUnits  Float    @default(0) @map("monthly_usage_units")
  estimatedCostCents Int      @default(0) @map("estimated_cost_cents")
  bandwidthBytes     BigInt   @default(0) @map("bandwidth_bytes")
  storageBytes       BigInt   @default(0) @map("storage_bytes")
  recordedAt         DateTime @default(now()) @map("recorded_at")

  @@unique([companyId, provider, period])
  @@map("integration_cost_snapshots")
}

model PlatformIdempotencyKey {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  key       String
  result    String?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@unique([companyId, key])
  @@index([expiresAt])
  @@map("platform_idempotency_keys")
}

// ─── Mission Control (Phase 1.5G) ───────────────────────────

model MissionControlLayout {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  widgets   Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("mission_control_layouts")
}

model PlatformHealthSnapshot {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  score      Int
  status     String
  breakdown  Json     @default("{}")
  services   Json     @default("[]")
  recordedAt DateTime @default(now()) @map("recorded_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, recordedAt])
  @@map("platform_health_snapshots")
}

model ReadinessSnapshot {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  overallScore     Int      @map("overall_score")
  dataCompleteness Float    @map("data_completeness")
  dimensions       Json     @default("[]")
  recordedAt       DateTime @default(now()) @map("recorded_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, recordedAt])
  @@map("readiness_snapshots")
}

model PlatformJob {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  actionId      String    @map("action_id")
  status        String    @default("pending")
  payload       Json      @default("{}")
  result        Json?
  error         String?
  userId        String?   @map("user_id")
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([correlationId])
  @@map("platform_jobs")
}

// ─── Platform Operations (Phase 1.5H) ───────────────────────

model PlatformMetricSnapshot {
  id         String   @id @default(uuid())
  name       String
  category   String
  value      Float
  unit       String
  labels     Json     @default("{}")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([category, recordedAt])
  @@index([name, recordedAt])
  @@map("platform_metric_snapshots")
}

model DiagnosticSnapshot {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  findings   Json     @default("[]")
  summary    Json     @default("{}")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([recordedAt])
  @@map("diagnostic_snapshots")
}

model ReliabilitySnapshot {
  id         String   @id @default(uuid())
  serviceId  String   @map("service_id")
  profile    Json
  window     String
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([serviceId, recordedAt])
  @@map("reliability_snapshots")
}

model PlatformInfraCostSnapshot {
  id                  String   @id @default(uuid())
  period              String
  breakdown           Json     @default("{}")
  totalEstimatedCents Int      @map("total_estimated_cents")
  recordedAt          DateTime @default(now()) @map("recorded_at")

  @@unique([period])
  @@map("platform_infra_cost_snapshots")
}

model PlatformRecoveryOperation {
  id          String    @id @default(uuid())
  type        String
  subsystem   String
  status      String    @default("pending")
  parameters  Json      @default("{}")
  result      Json?
  error       String?
  initiatedBy String?   @map("initiated_by")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([status])
  @@map("platform_recovery_operations")
}

model PlatformReadinessReport {
  id           String   @id @default(uuid())
  version      Int      @default(1)
  verdict      String
  overallScore Int      @map("overall_score")
  sections     Json     @default("[]")
  blockers     Json     @default("[]")
  generatedAt  DateTime @default(now()) @map("generated_at")

  @@index([generatedAt])
  @@map("platform_readiness_reports")
}

model PlatformSnapshot {
  id          String   @id @default(uuid())
  name        String
  description String?
  tables      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_snapshots")
}

model GovernanceEntry {
  id            String   @id @default(uuid())
  type          String
  title         String
  description   String
  actorId       String?  @map("actor_id")
  correlationId String   @map("correlation_id")
  eventId       String?  @map("event_id")
  metadata      Json     @default("{}")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  @@index([type, recordedAt])
  @@index([correlationId])
  @@map("governance_entries")
}

model SecurityFindingSnapshot {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  score      Int
  status     String
  findings   Json     @default("[]")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([recordedAt])
  @@map("security_finding_snapshots")
}
